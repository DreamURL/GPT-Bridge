# 소스와 빌드 도구는 .vsix에 넣지 않는다. dist/extension.js만 있으면 된다.
.vscode/**
.github/**
src/**
esbuild.mjs
tsconfig.json
.gitignore
**/*.map
PROGRESS.md
project.md

# node_modules는 통째로 제외하되 ripgrep만 되살린다 (project.md §2.1).
#
# esbuild가 '@vscode/ripgrep'을 external로 남기므로 런타임 require가 실제
# 파일을 찾아야 한다. rgPath는 node_modules/@vscode/ripgrep/bin/rg 를 가리키는
# 문자열일 뿐이고, 그 바이너리는 postinstall이 내려놓은 별도 파일이라
# 번들러가 따라오게 만들 수 없다.
#
# 아래 negation을 지우면 개발 중에는 정상 동작하다가 .vsix 설치본에서만
# search_text / list_directory가 실패한다.
node_modules/**
!node_modules/@vscode/ripgrep/**
