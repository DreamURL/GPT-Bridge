# 소스와 빌드 도구는 .vsix에 넣지 않는다. dist/extension.js만 있으면 된다.
.vscode/**
.github/**
src/**
esbuild.mjs
tsconfig.json
.gitignore
**/*.map
PROGRESS.md
project.md

test/**
out-test/**

# node_modules는 통째로 제외하되 ripgrep 바이너리만 되살린다 (project.md §2.1).
#
# 주의: 바이너리는 `@vscode/ripgrep/bin/rg`에 없다. 1.18부터 플랫폼별 optional
# 패키지(`@vscode/ripgrep-linux-x64` 등)로 분리되었고, 메타 패키지는 경로를
# 계산해 주는 ESM 모듈일 뿐이다. 그래서 아래 두 번째 negation이 실제 바이너리를
# 담당한다. 이것을 빠뜨리면 개발 중에는 정상 동작하다가 .vsix 설치본에서만
# search_text / list_directory가 실패한다.
#
# npm은 패키징하는 기기의 플랫폼 패키지만 설치한다. 다른 OS/아키텍처에서 쓰려면
# 그 기기에서 다시 패키징해야 한다.
node_modules/**
!node_modules/@vscode/ripgrep/**
!node_modules/@vscode/ripgrep-*/**
